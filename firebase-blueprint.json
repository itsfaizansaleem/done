{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Represents a purchase for a digital product.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The Clerk user ID of the purchaser." },
        "email": { "type": "string", "format": "email", "description": "Contact email for the order." },
        "phone": { "type": "string", "description": "Contact phone for the order." },
        "productName": { "type": "string", "description": "The name of the product purchased." },
        "price": { "type": "number", "description": "Price paid in PKR." },
        "status": { "type": "string", "enum": ["processing", "completed", "cancelled"], "description": "Current status of the order." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the order was created." }
      },
      "required": ["userId", "email", "phone", "productName", "price", "status", "createdAt"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all customer orders."
    }
  }
}
